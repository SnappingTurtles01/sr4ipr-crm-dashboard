# SR4IPR CRM — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# PostgreSQL connection string (Neon URLs should include sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-long-random-secret-string-minimum-32-chars

# Server port (Railway sets this automatically, keep 3000 for local dev)
PORT=3000

# Environment
NODE_ENV=production
